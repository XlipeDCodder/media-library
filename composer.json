{
    "name": "musicplayer/media-library",
    "description": "Query the Android device audio library (MediaStore) from NativePHP Mobile — ready-to-use track metadata, folders, albums, artists and artwork.",
    "keywords": ["nativephp", "android", "mediastore", "audio", "music", "media", "metadata"],
    "homepage": "https://github.com/XlipeDCodder/media-library",
    "support": {
        "issues": "https://github.com/XlipeDCodder/media-library/issues",
        "source": "https://github.com/XlipeDCodder/media-library"
    },
    "type": "nativephp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Felipe Almeida",
            "email": "you@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Musicplayer\\MediaLibrary\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Musicplayer\\MediaLibrary\\MediaLibraryServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}